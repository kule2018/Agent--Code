{
  "name": "08-streaming-voice", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.20" },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "check": "tsc --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "build": "npm run check && vite build --config web/vite.config.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/sandbox-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2", "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2", "@nestjs/platform-ws": "12.1.2",
    "@nestjs/websockets": "12.1.2", "reflect-metadata": "0.2.2", "rxjs": "7.8.2",
    "vue": "3.5.43", "@lucide/vue": "1.54.0", "ws": "8.22.0",
    "openai": "7.30.0", "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1", "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0", "vite": "^7.1.5", "typescript": "^5.9.2",
    "tsx": "^4.20.5", "vue-tsc": "^3.0.0", "concurrently": "^9.2.1"
  }
}
