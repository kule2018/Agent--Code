{
  "name": "09-ai-data-analysis-agent", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.20" },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "samples": "tsx scripts/create-samples.ts",
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "check": "tsc --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "build": "npm run check && vite build --config web/vite.config.ts",
    "test": "tsx --test test/*.test.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2", "@nestjs/core": "12.1.2", "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-ws": "12.1.2", "@nestjs/websockets": "12.1.2", "reflect-metadata": "0.2.2", "rxjs": "7.8.2",
    "@langchain/langgraph": "1.4.21", "@langchain/core": "1.2.17",
    "@duckdb/node-api": "1.5.6-r.1", "exceljs": "4.4.0", "csv-parse": "7.0.3",
    "vue": "3.5.43", "echarts": "6.1.0", "@lucide/vue": "1.54.0",
    "ws": "8.22.0", "openai": "7.30.0", "zod": "4.6.5"
  },
  "overrides": { "exceljs": { "uuid": "11.1.1" } },
  "devDependencies": {
    "@types/node": "^22.18.1", "@types/ws": "^8.18.1", "@types/express": "^5.0.3", "@types/multer": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0", "vite": "^7.1.5", "typescript": "^5.9.2",
    "tsx": "^4.20.5", "vue-tsc": "^3.0.0", "concurrently": "^9.2.1"
  }
}
