{
	"name": "06-software-engineering-agent",
	"version": "1.0.0",
	"private": true,
	"description": "第四章综合实战：能够分析代码、修改文件并验证结果的软件开发 Agent",
	"scripts": {
		"dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "tsx watch --tsconfig server/tsconfig.json server/src/main.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "npm run build:server && npm run build:web",
		"build:server": "tsc -p server/tsconfig.json",
		"build:web": "vite build --config web/vite.config.ts",
		"check": "tsc -p server/tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
		"test": "vitest run --config vitest.config.mts",
		"start": "node dist/server/main.js"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.6",
		"@nestjs/core": "^11.1.6",
		"@nestjs/platform-express": "^11.1.6",
		"diff": "^8.0.2",
		"@lucide/vue": "^1.27.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/node": "^22.18.1",
		"@vitejs/plugin-vue": "^6.0.0",
		"concurrently": "^9.2.1",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"vite": "^7.1.5",
		"vitest": "^3.2.4",
		"vue-tsc": "^3.0.0"
	}
}
